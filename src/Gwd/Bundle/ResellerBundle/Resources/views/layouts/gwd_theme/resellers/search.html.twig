{% block _resellers_search_widget %}
    <div {{ block('block_attributes') }}>
        <form method="get" action="{{ path('resellers') }}" class="search-form">
            <div class="input-group">
                <input type="text"
                       name="search"
                       value="{{ app.request.query.get('search') }}"
                       placeholder="{{ 'gwd.reseller.search.placeholder'|trans }}"
                       class="search-input"
                />
                <button class="search-btn" type="submit">
                    {{ 'gwd.reseller.search.button'|trans }}
                </button>
            </div>

        </form>
    </div>
{% endblock %}