{% extends '@OroUI/actions/view.html.twig' %}

{% import '@OroUI/macros.html.twig' as UI %}
{% import '@OroEntityConfig/macros.html.twig' as entityConfig %}

{% set pageTitle = entity.name %}

{% block navButtons %}
    {% import '@OroUI/macros.html.twig' as UI %}

    {% if is_granted('EDIT', entity) %}
        {{ UI.editButton({
            'path': path('gwd_reseller_update', { 'id': entity.id }),
            'entity_label': 'gwd.reseller.entity_label'|trans
        }) }}
    {% endif %}

    {% if is_granted('DELETE', entity) %}
        {{ UI.deleteButton({
            'dataUrl': path('oro_action_operation_execute', {
                operationName: 'DELETE',
                entityId: entity.id,
                entityClass: 'Gwd\\Bundle\\ResellerBundle\\Entity\\Reseller'
            }),
            'dataRedirect': path('gwd_reseller_index'),
            'aCss': 'no-hash remove-button',
            'id': 'btn-remove-reseller',
            'dataId': entity.id,
            'entity_label': 'gwd.reseller.entity_label'|trans
        }) }}
    {% endif %}
{% endblock navButtons %}

{% block pageHeader %}
    {% set breadcrumbs = {
        'entity': entity,
        'indexPath': path('gwd_reseller_index'),
        'indexLabel': 'gwd.reseller.entity_plural_label'|trans,
        'entityTitle': entity.name
    } %}
    {{ parent() }}
{% endblock pageHeader %}

{% block content_data %}
    {% set resellerInfo %}
        <div class="row-fluid form-horizontal">
            <div class="responsive-block">
                {{ UI.renderProperty('gwd.reseller.name.label'|trans, entity.name) }}
                {{ UI.renderProperty('gwd.reseller.email.label'|trans, entity.email) }}
                {{ UI.renderProperty('gwd.reseller.phone.label'|trans, entity.phone) }}
                {{ UI.renderProperty('gwd.reseller.website.label'|trans, entity.website ? '<a href="' ~ entity.website ~ '" target="_blank">' ~ entity.website ~ '</a>') }}
                {{ UI.renderProperty('gwd.reseller.address.label'|trans, entity.address|nl2br) }}
                {{ UI.renderProperty('gwd.reseller.description.label'|trans, entity.description|nl2br) }}
                {{ UI.renderProperty('gwd.reseller.authorized.label'|trans, entity.authorized ? 'Yes'|trans : 'No'|trans) }}
                {{ UI.renderProperty('gwd.reseller.status.label'|trans, entity.status|capitalize) }}

                {% if entity.logo %}
                    {{ UI.renderHtmlProperty('gwd.reseller.logo.label'|trans, UI.renderImageContent(entity.logo)) }}
                {% endif %}

                {{ UI.renderProperty('oro.ui.created_at'|trans, entity.createdAt|oro_format_datetime) }}
                {{ UI.renderProperty('oro.ui.updated_at'|trans, entity.updatedAt|oro_format_datetime) }}
            </div>
        </div>
    {% endset %}

    {% set dataBlocks = [
        {
            'title': 'General Information'|trans,
            'class': 'active',
            'subblocks': [
            {'data' : [resellerInfo]}
        ]
        }
    ] %}

    {% set id = 'resellerView' %}
    {% set data = {'dataBlocks': dataBlocks} %}

    {{ parent() }}
{% endblock content_data %}