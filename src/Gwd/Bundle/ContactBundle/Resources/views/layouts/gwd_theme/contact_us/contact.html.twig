{% block _contact_us_wrapper_widget %}
    <div {{ block('block_attributes') }}>

        {{ block_widget(block.children.contact_us_title) }}

        <div class="contect-us-content">
            {% if block.children.contact_us_info is defined %}
                {{ block_widget(block.children.contact_us_info) }}
            {% endif %}
            {{ block_widget(block.children.contact_us_form) }}
        </div>
    </div>
{% endblock %}

{% block _contact_us_form_widget %}
    <div class="contact-us-page__form">



        <div class="contact-us-content">
            <div class="contact-form">
                <form method="post" id="contactForm" action="{{ path('contact_us_submit') }}">

                    <div class="form-row">
                        <div class="form-group">
                            <label for="firstName">{{ 'gwd.contact.first_name'|trans }}</label>
                            <input type="text" id="firstName" name="firstName" class="form-control required">
                            <span class="input-error"></span>
                        </div>
                        <div class="form-group">
                            <label for="lastName">{{ 'gwd.contact.last_name'|trans }}</label>
                            <input type="text" id="lastName" name="lastName" class="form-control required" required>
                            <span class="input-error"></span>
                        </div>

                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="phone">{{ 'gwd.contact.phone'|trans }}</label>
                            <input type="text" id="phone" name="phone" class="form-control required" required>
                            <span class="input-error"></span>
                        </div>
                        <div class="form-group">
                            <label for="email">{{ 'gwd.contact.email'|trans }}</label>
                            <input type="text" id="email" name="email" class="form-control required" required>
                            <span class="input-error"></span>
                        </div>
                    </div>


                    <div class="form-row">
                        <div class="form-group">
                            <label for="subject">{{ 'gwd.contact.subject'|trans }}</label>
                            <input type="text" id="subject" name="subject" class="form-control required" required>
                            <span class="input-error"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="message">{{ 'gwd.contact.message'|trans }}</label>
                            <textarea id="message" name="message" class="form-control required" rows="8" required></textarea>
                            <span class="input-error"></span>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        {{ 'gwd.contact.submit'|trans }}
                    </button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}


{% block _contact_us_title_widget %}
    <h1 class="contact-us-page__title"> {{ oro_config_value('gwd_config.contact_page_title') }}</h1>
{% endblock %}